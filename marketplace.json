{
  "name": "my-market-demo",
  "description": "Internal team plugin marketplace",
  "pluginRoot": "plugins",
  "allowCrossMarketplaceDependenciesOn": ["zcode-plugins-official"],
  "plugins": [
    {
      "name": "hello-world",
      "source": "./hello-world",
      "description": "A greeting plugin",
      "version": "0.1.0",
      "category": "demo",
      "tags": ["starter", "demo"],
      "strict": true
    },
    {
      "name": "from-github",
      "source": { "source": "github", "repo": "chao-dev-ai/zcodeplugin", "path": "from-url1", "ref": "main" },
      "dependencies": []
    },
    {
      "name": "from-git",
      "source": { "source": "git", "url": "http://127.0.0.1:18080/download/plugin-test-01", "path": "sk01", "ref": "v1.0" }
    },
    {
      "name": "from-dir",
      "source": { "source": "directory", "path": "/abs/path/to/plugin" }
    },
    {
      "name": "from-url",
      "source": { "source": "url", "url": "https://github.com/chao-dev-ai/zcodeplugin/blob/main/from-url/.zcode-plugin/plugin.json", "headers": { "Authorization": "Bearer xxx" } }
    },
    {
      "name": "from-npm",
      "source": { "source": "npm", "package": "@scope/plugin" }
    },
    {
      "name": "test-hello",
      "description": "hello world",
      "version": "1.0.0",
      "category": "demo",
      "source": { "source": "url", "url": "http://127.0.0.1:18080/plugin-manifest.json"}
    }
  ]
}
